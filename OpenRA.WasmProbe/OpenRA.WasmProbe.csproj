<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TargetFramework comes from Directory.Build.props (net10.0). -->
    <RootNamespace>OpenRA.WasmProbe</RootNamespace>
    <!-- Probe goal is signal, not shipping: keep trimming off so we see the full
         closure of OpenRA.Game compile/link against the browser runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" />
  </ItemGroup>
</Project>
