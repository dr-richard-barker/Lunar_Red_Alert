<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TargetFramework comes from Directory.Build.props (net10.0). -->
    <RootNamespace>OpenRA.WasmProbe</RootNamespace>
    <!-- Probe goal is signal, not shipping: keep trimming off so we see the full
         closure of OpenRA.Game compile/link against the browser runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" />
    <!-- W3e: the mod assemblies. Both are managed-only (no native NuGets), so
         they should publish for browser-wasm; their trait types are resolved
         by ObjectCreator via the resident-assembly fallback. -->
    <ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj" />
    <ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj" />
  </ItemGroup>
  <!-- Directory.Build.props removes ALL analyzers on Release builds to speed up
       compiles — but source generators (including the [JSImport] generator) run
       inside the analyzer host, so that leaves every [JSImport] partial method
       without an implementation (CS8795). Neutralize that target for this
       project only: a same-named target defined later wins. -->
  <Target Name="DisableAnalyzers" />
</Project>
